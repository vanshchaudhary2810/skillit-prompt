digraph G { rankdir=TB; node [fontname="Liberation Serif", fontsize=11, style="rounded,filled", shape=box, fillcolor="#F3EADF", color="#8B5A2B"]; edge [fontname="Liberation Serif", fontsize=9, color="#555555"];
in [label="Student input\nskills text, target role, hours/week, weeks", fillcolor="#FEF3C7", color="#B45309"];
p1 [label="P1 Skill Normaliser\n(LLM, JSON)"]; d1 [label="status ==\ninvalid_input?", shape=diamond, fillcolor="#FFFFFF"];
